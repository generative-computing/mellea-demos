# LLM — OpenAI-compatible endpoint (default: vLLM serving Granite Switch)
LLM_URL=http://localhost:8000/v1
LLM_MODEL=ibm-granite/granite-switch-4.1-3b-preview
# LLM_API_KEY=

# Hosted STT — vLLM speech endpoint (Granite speech)
VLLM_SPEECH_URL=http://localhost:8083
VLLM_SPEECH_MODEL=ibm-granite/granite-speech-4.1-2b
VLLM_SPEECH_PATH=/v1/chat/completions
VLLM_SPEECH_BEARER_TOKEN=token-abc123
# Comma-separated keyword bias appended to the STT prompt
STT_KEYWORD_BIAS=Granite,Mellea

# TTS backend: "kokoro" (default, runs locally) or "hosted" (remote HTTP server)
TTS_BACKEND=kokoro

# Kokoro TTS (used when TTS_BACKEND=kokoro)
TTS_VOICE=af_aoede

# Hosted TTS (used when TTS_BACKEND=hosted). The server is expected to accept
# POST {"text": "..."} and stream raw PCM audio at HOSTED_TTS_SAMPLE_RATE.
HOSTED_TTS_URL=http://localhost:8086
HOSTED_TTS_PATH=/synth
HOSTED_TTS_SAMPLE_RATE=24000

# Optional prompt file — replaces the default system prompt. See prompts/granite.txt
# for the persona used in the THINK 2026 demo.
# PROMPT_FILE=prompts/granite.txt

# Optional documents directory — all .txt files are loaded as mellea Documents
# and attached to user messages for RAG-style grounding
# DOCUMENTS_DIR=docs

# HuggingFace token — required in Colab/remote deployments to mint per-session
# WebRTC TURN credentials (https://turn.fastrtc.org/credentials, 10GB/mo free
# per token). Optional for localhost dev where direct WebRTC works without a
# relay. Generate a read token at https://huggingface.co/settings/tokens.
# HF_TOKEN=

# Server
HOST=localhost
PORT=7860
